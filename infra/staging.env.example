# Staging overlay for infra/docker-compose.yml
# This is STAGING, not production. Compose Redis is redis:// (plaintext).
# Production gates still require mongodb+srv://, rediss://, public HTTPS keepers,
# and a human-set FLARE_GOVERNANCE_STATUS=production-approved.
#
# Copy:  cp infra/staging.env.example .env.staging
# Start: docker compose --env-file infra/staging.env.example -f infra/docker-compose.yml up -d
# Do not treat a green local stack as T6.4 managed ops.

FLARE_NETWORK=local
FLARE_API_CHAIN_ID=31337
FLARE_RPC_URL=http://127.0.0.1:8545

FLARE_MONGO_URL=mongodb://127.0.0.1:27017
FLARE_MONGO_DATABASE=trustrfq
FLARE_INDEXER_MONGO_URL=mongodb://127.0.0.1:27017
FLARE_INDEXER_REDIS_URL=redis://127.0.0.1:6379
FLARE_KEEPER_REDIS_URL=redis://127.0.0.1:6379
FLARE_KEEPER_REQUIRE_JOB_SOURCES=false

FLARE_API_HOST_PORT=8787
FLARE_INDEXER_HOST_PORT=8790
FLARE_KEEPER_HOST_PORT=8791
FLARE_BROKER_HOST_PORT=6379
FLARE_ANVIL_HOST_PORT=8545
FLARE_MATCHER_HOST_PORT=8090

# Optional local self-signed TLS (NOT production):
#   node tools/generate-local-tls.mjs
# FLARE_API_TLS_CERT_FILE=infra/tls-local/server.crt
# FLARE_API_TLS_KEY_FILE=infra/tls-local/server.key
# FLARE_API_TLS_CA_FILE=infra/tls-local/client-ca.crt
