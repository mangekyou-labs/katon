# Local Seller Desk API
KATON_LOCALNET=1
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_API_PORT=8787
SOLANA_API_HOST=127.0.0.1

# Optional localnet fixture and operator evidence paths. Keep private keys under .local/.
# KATON_LOCALNET_FIXTURE=.local/solana-seller-localnet.json
# SOLANA_OPERATOR_EVIDENCE_DIR=.local/operator-evidence

# Optional browser proxy target for local API development.
# SOLANA_API_PROXY=http://localhost:8787
