# Local Seller Desk API
KATON_LOCALNET=1
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_API_PORT=8787
SOLANA_API_HOST=127.0.0.1

# Optional localnet fixture and operator evidence paths. Keep private keys under .local/.
# KATON_LOCALNET_FIXTURE=.local/solana-seller-localnet.json
# SOLANA_OPERATOR_EVIDENCE_DIR=.local/operator-evidence

# Optional browser proxy target for local API development.
# SOLANA_API_PROXY=http://localhost:8787

# Optional server-side live quote gate. Missing or stale data blocks quotes.
# Never prefix these variables with VITE_; credentials stay on the API server.
# PYTH_PRO_API_KEY=
# PYTH_PRO_CHANNEL=fixed_rate@1000ms
# The independent endpoint returns symbol, priceAtomic (USD at 6 decimals),
# observedAtMs, marketSession, and corporateActionPending. It must be a
# separately sourced non-Pyth AAPL/USD observation.
# KATON_REFERENCE_CROSSCHECK_URL=https://your-server-side-adapter.example/aapl-usd
# KATON_REFERENCE_CROSSCHECK_PROVIDER=your-independent-provider
# KATON_REFERENCE_CROSSCHECK_BEARER=
