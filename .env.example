# Disposable local QA wallet only. Never use a production seed phrase here.
METAMASK_PASSWORD=
METAMASK_SEED_PHRASE=

# Flare Coston2 defaults. Mainnet is chain 14 / FLR and is approval-gated.
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_CHAIN_ID=114
FLARE_NETWORK_NAME=Flare Coston2
FLARE_CURRENCY_SYMBOL=C2FLR

# The running Flare dApp used to verify window.ethereum and the selected chain.
# npm run dev:flare serves apps/flare-web on Vite's default port.
DAPP_URL=http://127.0.0.1:5173

# FDC — public testnet smoke only (not paid). Paid key: GitHub issue #1458.
FLARE_FDC_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network
FLARE_FDC_DA_URL=https://ctn2-data-availability.flare.network
FLARE_FDC_API_KEY=00000000-0000-0000-0000-000000000000

# FCC public Coston2 (not real 2-of-3). Registries named TeeExtensionRegistry /
# TeeMachineRegistry are not in the official scaffold file — do not invent them.
FLARE_TEE_MANAGER=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
FCC_NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks/info
# FLARE_TEE_EXTENSION_REGISTRY=
# FLARE_TEE_MACHINE_REGISTRY=

# FCC Coston2 three-stack rehearsal. Keep all private values in the ignored
# .env.fcc.local generated by `npm run generate:flare:fcc:identities`.
# The official ext-proxy indexer path requires read-only credentials from
# Flare support; leave these blank until they are issued.
# FCC_INDEXER_MYSQL_HOST=34.38.42.208
# FCC_INDEXER_MYSQL_PORT=3306
# FCC_INDEXER_MYSQL_DATABASE=indexer
# FCC_INDEXER_MYSQL_USER=
# FCC_INDEXER_MYSQL_PASSWORD=
# FCC_PROXY_INFO_URLS=https://tee-a.example/info,https://tee-b.example/info,https://tee-c.example/info
# FCC_EXPECTED_SIGNING_POLICY_ID=
# FLARE_FCC_MODE=simulated
# FLARE_FCC_INSTRUCTION_SENDER=
# FLARE_FCC_EXTENSION_ID=65537
# FLARE_FCC_PROXY_URL_A=https://tee-a.example.invalid/info
# FLARE_FCC_PROXY_URL_B=https://tee-b.example.invalid/info
# FLARE_FCC_PROXY_URL_C=https://tee-c.example.invalid/info
# Local FCC rehearsal defaults: proxy port 6664 inside each stack, exposed as
# 8664/8764/8864. These HTTP URLs are not valid Coston2 registrations.
# FCC_TEE_A_HOST_PORT=8664
# FCC_TEE_B_HOST_PORT=8764
# FCC_TEE_C_HOST_PORT=8864

# Venues: leave unset until official Coston2 addresses exist.
# FLARE_VENUE_MANIFEST=
