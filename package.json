{
  "name": "katon-solana-desk",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/solana-*",
    "packages/solana-*",
    "services/solana-*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --config apps/solana-web/vite.config.ts",
    "dev:solana-api": "node --import tsx apps/solana-api/src/server.ts",
    "dev:solana-api:localnet": "KATON_LOCALNET=1 SOLANA_RPC_URL=${SOLANA_RPC_URL:-http://127.0.0.1:8899} node --import tsx apps/solana-api/src/server.ts",
    "seller:localnet": "node tools/solana-seller-localnet.mjs",
    "seller:loop": "node --import tsx tools/solana-seller-loop.mjs",
    "typecheck": "tsc -p tsconfig.solana.json --noEmit && tsc -p tsconfig.solana-api.json --noEmit && tsc -p apps/solana-web/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build --config apps/solana-web/vite.config.ts",
    "preview": "vite preview --config apps/solana-web/vite.config.ts",
    "test:solana:governance-validator": "node tools/solana-governance-validator-test.mjs",
    "test:solana:rfq-governance-validator": "node tools/solana-rfq-only-governance-validator-test.mjs",
    "test:solana:settlement-validator": "node tools/solana-settlement-validator-test.mjs",
    "smoke:solana:roles": "node --import tsx tools/solana-role-http-smoke.mjs",
    "test:e2e:solana:maker": "node tools/solana-maker-browser-fixture.mjs",
    "test:e2e:solana:maker:live": "node tools/solana-maker-live-browser-journey.mjs",
    "test:e2e:solana:seller": "node tools/solana-seller-browser-journey.mjs",
    "check:solana:release": "node scripts/check-solana-release.mjs",
    "setup:solana:credentials": "bash scripts/solana-credentials-wizard.sh",
    "qa:browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@solana/kit": "^8.3.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-signer": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@solana/react": "^8.3.0",
    "@solana/web3.js": "1.98.4",
    "buffer": "^6.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  }
}
