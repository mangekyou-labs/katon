# Combined simulated-TEE stack for a single Render free web service.
# Each service must use a distinct PROXY_PRIVATE_KEY. SIMULATED_TEE stays true.
ARG TEE_PROXY_VERSION=v0.0.18

FROM golang:1.25.1-alpine AS proxy-builder
RUN apk add --no-cache git
ARG TEE_PROXY_VERSION
WORKDIR /app
RUN git clone --depth 1 --branch ${TEE_PROXY_VERSION} https://github.com/flare-foundation/tee-proxy.git
WORKDIR /app/tee-proxy
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -a -o /out/proxy ./cmd/proxy

FROM golang:1.25.1-alpine AS tee-builder
RUN apk add --no-cache git ca-certificates
WORKDIR /build
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY go/cmd/ ./cmd/
COPY go/internal/ ./internal/
COPY go/pkg/ ./pkg/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS="-buildvcs=false" \
    go build -trimpath -ldflags="-buildid= -s -w" -o /out/extension-tee ./cmd/docker

FROM alpine:3.21
RUN apk add --no-cache redis ca-certificates
WORKDIR /app
COPY --from=proxy-builder /out/proxy /app/proxy
COPY --from=tee-builder /out/extension-tee /app/extension-tee
COPY scripts/start-render.sh /app/start-render.sh
RUN chmod 0755 /app/proxy /app/extension-tee /app/start-render.sh \
    && addgroup -g 1001 -S appgroup \
    && adduser -u 1001 -S appuser -G appgroup
ENV MODE=1 SIMULATED_TEE=true CHAIN_ID=114
EXPOSE 10000
USER root
CMD ["/app/start-render.sh"]
